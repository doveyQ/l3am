---
import { referenzen } from '../data/referenzen';
import HeroSignal from './HeroSignal.astro';

const zeigeProjekte = referenzen.length > 0;

// Der Titel läuft wortweise hinter einer Kante hervor. Deshalb wird er hier
// zerlegt statt im Browser — so steht im Markup echter Text, kein Skript-Ergebnis.
const zeilen = [
  { text: 'Pages, die auffallen.', akzent: false },
  { text: 'Prozesse, die von selbst laufen.', akzent: true },
].map((z) => ({ ...z, woerter: z.text.split(' ') }));
---

<section id="inhalt" class="relative border-b border-rule">
  <div class="shell relative flex min-h-[calc(100svh-4rem)] flex-col">
    <div
      class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-rule py-3.5"
    >
      <span class="tech-label text-[0.625rem] text-ink-3 sm:text-[0.6875rem]">
        [ TU GRAZ SOFTWARE ENGINEERING / EST. 2026 ]
      </span>
      <span class="tech-label hidden tabular-nums text-ink-4 lg:inline"
        >47.0707° N · 15.4395° E · GRAZ</span
      >
    </div>

    <div class="grid flex-1 content-center gap-x-16 gap-y-10 py-10 md:py-12 lg:grid-cols-12">
      <div class="lg:col-span-8 xl:col-span-8">
        <h1 class="display woerter" data-woerter>
          {
            zeilen.map((zeile, zi) => (
              <span class="block">
                {zeile.woerter.map((wort, wi) => (
                  <span class="woerter__slot">
                    <span
                      class={zeile.akzent ? 'woerter__wort text-accent' : 'woerter__wort'}
                      style={`--w:${zi * 4 + wi}`}
                    >
                      {wort}
                    </span>
                  </span>
                ))}
              </span>
            ))
          }
        </h1>

        <p
          class="rise mt-8 max-w-[46ch] text-[length:var(--text-lead)] leading-[1.55] text-ink-3"
          style="--rise-delay:260ms"
        >
          Wir gestalten und bauen Landingpages, Websites und Webapps — auf Wunsch
          bis in den Backend-Stack. Und wir automatisieren mit KI, was danach
          jeden Tag von Hand passieren würde.
        </p>

        <div
          class="rise mt-12 flex flex-col gap-3 border-t border-rule pt-8 sm:flex-row sm:items-center sm:gap-4"
          style="--rise-delay:380ms"
        >
          <a
            href="#kontakt"
            class="group inline-flex items-center justify-between gap-6 border border-accent bg-accent px-6 py-4 text-[0.9375rem] text-paper no-underline transition-colors duration-300 hover:bg-transparent hover:text-accent sm:justify-start"
          >
            Erstgespräch buchen
            <span
              class="inline-block h-px w-5 bg-current transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:w-9"
              aria-hidden="true"></span>
          </a>

          {
            zeigeProjekte && (
              <a
                href="#referenzen"
                class="group inline-flex items-center justify-between gap-6 border border-rule-strong px-6 py-4 text-[0.9375rem] text-ink no-underline transition-colors duration-300 hover:border-accent hover:text-accent sm:justify-start"
              >
                Projekte ansehen
                <span
                  class="inline-block h-px w-5 bg-current transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:w-9"
                  aria-hidden="true"
                />
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div class="rise pb-8 md:pb-10" style="--rise-delay:520ms">
      <HeroSignal />
    </div>
  </div>
</section>
