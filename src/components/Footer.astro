---
const jahr = new Date().getFullYear();
---

<footer class="border-rule">
  <div class="shell">
    <div class="grid gap-x-16 gap-y-10 py-16 md:py-20 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="text-[clamp(1.5rem,1.1rem+1vw,2rem)] leading-[1.1] font-medium tracking-[-0.04em]">
          leam
        </p>
        <p class="mt-4 max-w-[28ch] text-[0.9375rem] leading-[1.6] text-ink-3">
          Studio aus Graz für Frontend, Full-Stack und KI-Automatisierung.
        </p>
      </div>

      <nav class="lg:col-span-4" aria-label="Fußzeilennavigation">
        <span class="tech-label">Seite</span>
        <ul class="mt-5 space-y-3">
          {
            [
              { href: '#leistungen', label: 'Leistungen' },
              { href: '#team', label: 'Team' },
              { href: '#stack', label: 'Stack' },
              { href: '#kontakt', label: 'Kontakt' },
            ].map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-[0.9375rem] text-ink-3 no-underline transition-colors duration-300 hover:text-accent"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <span class="tech-label">Kontakt</span>
        <ul class="mt-5 space-y-3">
          <li>
            <a
              href="mailto:hallo@l3am.dev"
              class="text-[0.9375rem] text-ink-3 no-underline transition-colors duration-300 hover:text-accent"
              >hallo@l3am.dev</a
            >
          </li>
          <li class="font-mono text-[0.8125rem] text-ink-4">Graz, Österreich</li>
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col gap-4 border-t border-rule py-7 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="tech-label">© {jahr} leam · L3AM.DEV</p>
      <!--
        AUSZUFÜLLEN: Impressum und Datenschutzerklärung sind in Österreich
        gesetzlich verpflichtend (§ 5 ECG, § 25 MedienG, DSGVO Art. 13).
        Inhalte müssen von euch kommen — hier sind nur die Routen vorgesehen.
      -->
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <li>
          <a
            href="/impressum"
            class="tech-label text-ink-4 no-underline transition-colors duration-300 hover:text-accent"
            >Impressum</a
          >
        </li>
        <li>
          <a
            href="/datenschutz"
            class="tech-label text-ink-4 no-underline transition-colors duration-300 hover:text-accent"
            >Datenschutz</a
          >
        </li>
      </ul>
    </div>
  </div>
</footer>
