---
import maske from '../data/landmask.json';
import europa from '../data/europamask.json';

/**
 * Der Globus.
 *
 * Eine Erdkugel aus denselben Punkten wie der Untergrund — dieselbe Sprache,
 * nur zur Kugel gerollt. Sie dreht sich von selbst, wächst beim Scrollen,
 * dreht Europa nach vorn, zoomt hinein und markiert den DACH-Raum.
 *
 * Die Landmaske ist zur Bauzeit aus dem 110m-Datensatz von world-atlas
 * erzeugt (scripts/build-landmask.mjs) und wiegt ~4,7 kB base64 statt
 * mehrerer hundert kB GeoJSON. Projektion: orthographisch, von Hand.
 */

// Mittelpunkt und Ausdehnung des DACH-Raums, in Grad.
const DACH = { lon: 10.5, lat: 48.6, lon0: 5.8, lon1: 17.2, lat0: 45.7, lat1: 55.1 };
const GRAZ = { lon: 15.44, lat: 47.07 };
---

<section id="reichweite" class="relative border-b border-rule" data-globus-sektion>
  <div class="sticky top-16 flex h-[calc(100svh-4rem)] items-center overflow-hidden">
    <div class="shell relative w-full">
      <div class="grid items-center gap-x-16 gap-y-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="section-head reveal rise">
            <span><span>Von Graz aus.</span></span>
            <span><span class="text-ink-3" style="--line:1">Für den DACH-Raum.</span></span>
          </h2>
          <p class="rise mt-7 max-w-[40ch] leading-[1.6] text-ink-3" style="--rise-delay:180ms">
            Wir arbeiten auf Deutsch und in eurer Zeitzone. Angebote, Verträge und
            Rechnungen nach österreichischem Recht — kein Zeitversatz, keine
            Übersetzungsschleife.
          </p>
          <dl class="rise mt-10 border-t border-rule" style="--rise-delay:300ms">
            {
              [
                ['Sprache', 'Deutsch'],
                ['Zeitzone', 'MEZ / MESZ'],
                ['Sitz', 'Graz, Österreich'],
              ].map(([k, v]) => (
                <div class="flex items-baseline justify-between gap-6 border-b border-rule py-3">
                  <dt class="tech-label">{k}</dt>
                  <dd class="font-mono text-[0.8125rem] text-ink-2">{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="relative lg:col-span-7">
          <canvas
            data-globus
            class="block aspect-square w-full"
            role="img"
            aria-label="Rotierende Erdkugel, die auf den DACH-Raum zoomt: Deutschland, Österreich und die Schweiz"></canvas>
        </div>
      </div>
    </div>
  </div>

  {/* Die Scrollstrecke, über die sich die Kugel dreht und zoomt. */}
  <div class="h-[220vh]" aria-hidden="true"></div>
</section>

<script define:vars={{ maske, europa, DACH, GRAZ }}>
  const canvas = document.querySelector('[data-globus]');
  const sektion = document.querySelector('[data-globus-sektion]');

  if (canvas && sektion) {
    const ctx = canvas.getContext('2d');
    const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)');

    const INK = '113, 113, 122';
    const ACCENT = '63, 74, 138';
    const RULE = '212, 212, 216';

    // Landmaske auspacken: ein Bit pro Rasterpunkt.
    const bits = Uint8Array.from(atob(maske.bits), (c) => c.charCodeAt(0));
    const punkte = [];
    for (let r = 0; r < maske.rows; r++) {
      const lat = 90 - r * maske.step - maske.step / 2;
      for (let c = 0; c < maske.cols; c++) {
        const i = r * maske.cols + c;
        if (!((bits[i >> 3] >> (i & 7)) & 1)) continue;
        const lon = -180 + c * maske.step + maske.step / 2;
        const phi = (lat * Math.PI) / 180;
        const lam = (lon * Math.PI) / 180;
        punkte.push({
          lat, lon,
          // Kartesisch vorrechnen: pro Bild bleibt dann nur noch die Drehung.
          cp: Math.cos(phi), sp: Math.sin(phi), lam,
          dach: lon >= DACH.lon0 && lon <= DACH.lon1 && lat >= DACH.lat0 && lat <= DACH.lat1,
        });
      }
    }

    // Feine Regionalmaske: erst beim Hineinzoomen sichtbar, dafür mit
    // echten Ländergrenzen für Deutschland, Österreich und die Schweiz.
    const eLand = Uint8Array.from(atob(europa.land), (c) => c.charCodeAt(0));
    const eDach = Uint8Array.from(atob(europa.dach), (c) => c.charCodeAt(0));
    const feine = [];
    const RAND = 6; // Zellen, über die zum Maskenrand hin ausgefedert wird
    for (let r = 0; r < europa.rows; r++) {
      const lat = europa.lat1 - r * europa.step - europa.step / 2;
      for (let c = 0; c < europa.cols; c++) {
        const i = r * europa.cols + c;
        if (!((eLand[i >> 3] >> (i & 7)) & 1)) continue;
        const lon = europa.lon0 + c * europa.step + europa.step / 2;
        const phi = (lat * Math.PI) / 180;
        // Am Rand des Ausschnitts weich auslaufen, damit die Maske nicht
        // als gerade Kante endet.
        const nahRand = Math.min(c, europa.cols - 1 - c, r, europa.rows - 1 - r);
        feine.push({
          cp: Math.cos(phi), sp: Math.sin(phi), lam: (lon * Math.PI) / 180,
          dach: !!((eDach[i >> 3] >> (i & 7)) & 1),
          kante: Math.min(1, nahRand / RAND),
        });
      }
    }

    let w = 0, h = 0, raf = 0, fortschritt = 0, drehung = 0, zuletzt = 0;

    function messen() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function scrollFortschritt() {
      const r = sektion.getBoundingClientRect();
      const strecke = r.height - window.innerHeight;
      if (strecke <= 0) return 0;
      return Math.min(1, Math.max(0, -r.top / strecke));
    }

    const glatt = (t) => t * t * (3 - 2 * t);
    const stufe = (p, a, b) => glatt(Math.min(1, Math.max(0, (p - a) / (b - a))));

    /** Orthographische Projektion um (lam0, phi0). */
    function projizieren(p, lam0, phi0, radius, cx, cy) {
      const dl = p.lam - lam0;
      const cosdl = Math.cos(dl);
      const cosc = Math.sin(phi0) * p.sp + Math.cos(phi0) * p.cp * cosdl;
      if (cosc <= 0) return null; // Rückseite
      return {
        x: cx + radius * (p.cp * Math.sin(dl)),
        y: cy - radius * (Math.cos(phi0) * p.sp - Math.sin(phi0) * p.cp * cosdl),
        t: cosc,
      };
    }

    function zeichnen(t) {
      const dt = zuletzt ? Math.min(64, t - zuletzt) : 16;
      zuletzt = t;

      const p = fortschritt;

      // Phase 1 wachsen, Phase 2 Europa nach vorn, Phase 3 hineinzoomen.
      const wachsen = stufe(p, 0.0, 0.34);
      const ausrichten = stufe(p, 0.3, 0.62);
      const zoom = stufe(p, 0.6, 1.0);
      const markieren = stufe(p, 0.72, 0.95);

      const basis = Math.min(w, h) * 0.42;
      // Der Zoom bleibt moderat: weiter hinein macht aus Punkten nur Blasen,
      // weil die Maske ihre Auflösung nicht ändert. Detail kommt stattdessen
      // aus der feineren Regionalmaske.
      const radius = basis * (0.42 + wachsen * 0.58) * (1 + zoom * 1.25);
      const detail = stufe(p, 0.6, 0.82);

      // Freie Drehung, die zum Ausrichten hin ausläuft.
      if (!reduziert.matches) drehung += (dt / 1000) * 0.16 * (1 - ausrichten);

      const zielLam = (DACH.lon * Math.PI) / 180;
      const zielPhi = (DACH.lat * Math.PI) / 180;
      const lam0 = drehung * (1 - ausrichten) + zielLam * ausrichten;
      const phi0 = zielPhi * ausrichten;

      const cx = w / 2;
      const cy = h / 2;

      ctx.clearRect(0, 0, w, h);

      // Der Horizont der Kugel.
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(${RULE}, ${0.9 - zoom * 0.5})`;
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.clip();

      // Punktgröße folgt dem Rasterabstand, nicht dem Zoom — sonst werden
      // aus Landpunkten Blasen.
      const grobGroesse = Math.max(0.85, radius * 0.0042);
      const feinGroesse = Math.max(0.9, radius * 0.0032);

      // Grobe Weltmaske, blendet beim Hineinzoomen aus.
      {
        for (const pt of punkte) {
          const q = projizieren(pt, lam0, phi0, radius, cx, cy);
          if (!q) continue;
          if (q.x < -20 || q.x > w + 20 || q.y < -20 || q.y > h + 20) continue;
          const rand = Math.pow(q.t, 0.6);
          ctx.beginPath();
          ctx.fillStyle = `rgba(${INK}, ${0.5 * rand * (1 - detail * 0.62)})`;
          ctx.arc(q.x, q.y, grobGroesse, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Feine Regionalmaske, blendet dafür ein.
      if (detail > 0.01) {
        for (const pt of feine) {
          const q = projizieren(pt, lam0, phi0, radius, cx, cy);
          if (!q) continue;
          if (q.x < -20 || q.x > w + 20 || q.y < -20 || q.y > h + 20) continue;
          const rand = Math.pow(q.t, 0.6);
          const hervor = pt.dach ? markieren : 0;
          ctx.beginPath();
          ctx.fillStyle = pt.dach && hervor > 0.05
            ? `rgba(${ACCENT}, ${(0.45 + hervor * 0.5) * rand * detail})`
            : `rgba(${INK}, ${0.42 * rand * detail * pt.kante})`;
          ctx.arc(q.x, q.y, feinGroesse * (1 + hervor * 0.35), 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.restore();

      // Annotation auf den DACH-Raum, sobald hineingezoomt ist.
      if (markieren > 0.02) {
        const zentrum = projizieren(
          { lam: (DACH.lon * Math.PI) / 180, cp: Math.cos((DACH.lat * Math.PI) / 180), sp: Math.sin((DACH.lat * Math.PI) / 180) },
          lam0, phi0, radius, cx, cy,
        );
        const graz = projizieren(
          { lam: (GRAZ.lon * Math.PI) / 180, cp: Math.cos((GRAZ.lat * Math.PI) / 180), sp: Math.sin((GRAZ.lat * Math.PI) / 180) },
          lam0, phi0, radius, cx, cy,
        );

        if (zentrum) {
          const rr = radius * 0.115 * markieren;
          ctx.strokeStyle = `rgba(${ACCENT}, ${markieren * 0.75})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(zentrum.x, zentrum.y, rr, 0, Math.PI * 2);
          ctx.stroke();

          // Anschlusslinie mit Beschriftung, wie in einer Zeichnung.
          const lx = zentrum.x + rr * 0.71;
          const ly = zentrum.y - rr * 0.71;
          const ey = ly - 56 * markieren;
          const ex = Math.min(w - 132, lx + 70 * markieren);
          ctx.beginPath();
          ctx.moveTo(lx, ly);
          ctx.lineTo(ex, ey);
          ctx.lineTo(ex + 108, ey);
          ctx.stroke();

          // Schrift freistellen: ohne das liegt sie im Punktraster.
          ctx.fillStyle = `rgba(251, 251, 252, ${markieren * 0.92})`;
          ctx.fillRect(ex - 4, ey - 42, 300, 40);

          ctx.textBaseline = 'bottom';
          ctx.fillStyle = `rgba(${ACCENT}, ${markieren})`;
          ctx.font = '500 15px "Geist Mono", ui-monospace, monospace';
          ctx.fillText('DACH', ex + 2, ey - 22);
          ctx.fillStyle = `rgba(${INK}, ${markieren * 0.85})`;
          ctx.font = '400 11px "Geist Mono", ui-monospace, monospace';
          ctx.fillText('DEUTSCHLAND · ÖSTERREICH · SCHWEIZ', ex + 2, ey - 7);
        }

        if (graz && markieren > 0.4) {
          const a = (markieren - 0.4) / 0.6;
          ctx.fillStyle = `rgba(${ACCENT}, ${a})`;
          // Heller Saum, damit die Marke auf der Akzentfläche steht.
          ctx.fillStyle = `rgba(251, 251, 252, ${a})`;
          ctx.fillRect(graz.x - 5, graz.y - 5, 10, 10);
          ctx.fillStyle = `rgba(${INK}, ${a})`;
          ctx.fillRect(graz.x - 3, graz.y - 3, 6, 6);

          ctx.strokeStyle = `rgba(${INK}, ${a * 0.55})`;
          ctx.beginPath();
          ctx.moveTo(graz.x, graz.y + 7);
          ctx.lineTo(graz.x, graz.y + 62);
          ctx.lineTo(graz.x + 52, graz.y + 62);
          ctx.stroke();

          ctx.fillStyle = `rgba(251, 251, 252, ${a * 0.92})`;
          ctx.fillRect(graz.x + 54, graz.y + 52, 62, 20);
          ctx.fillStyle = `rgba(${INK}, ${a})`;
          ctx.font = '400 12px "Geist Mono", ui-monospace, monospace';
          ctx.textBaseline = 'middle';
          ctx.fillText('GRAZ', graz.x + 58, graz.y + 62);
        }
      }

    }

    function schleife(t) {
      zeichnen(t);
      raf = requestAnimationFrame(schleife);
    }

    messen();

    if (reduziert.matches) {
      // Ohne Bewegung: der Endzustand, genau ein Bild.
      fortschritt = 1;
      drehung = (DACH.lon * Math.PI) / 180;
      zeichnen(0);
    }

    let laeuft = false;
    const beobachter = new IntersectionObserver(
      (eintraege) => {
        for (const e of eintraege) {
          if (e.isIntersecting && !laeuft) {
            laeuft = true;
            zuletzt = 0;
            if (!reduziert.matches) raf = requestAnimationFrame(schleife);
          } else if (!e.isIntersecting && laeuft) {
            laeuft = false;
            cancelAnimationFrame(raf);
          }
        }
      },
      { rootMargin: '10% 0px' },
    );
    beobachter.observe(sektion);

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          fortschritt = scrollFortschritt();
          ticking = false;
        });
      },
      { passive: true },
    );
    fortschritt = scrollFortschritt();

    let timer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        messen();
        fortschritt = scrollFortschritt();
        if (reduziert.matches) zeichnen(0);
      }, 160);
    });
  }
</script>
