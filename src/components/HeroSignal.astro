---
/**
 * Das Signet im Hero: drei Module, die zeigen, was hier tatsächlich passiert
 * — eine Oberfläche entsteht, Logik wird geschrieben, ein Ablauf läuft
 * danach von selbst. Alles autonom animiert, reines SVG plus CSS-Keyframes,
 * kein Skript.
 */

const module = [
  { id: 'interface', label: 'Interface', bezug: 'Was man sieht' },
  { id: 'logik', label: 'Logik', bezug: 'Was es kann' },
  { id: 'automation', label: 'Automation', bezug: 'Was von selbst läuft' },
];
---

<div class="signet grid grid-cols-3 border-t border-rule" data-signet>
  {
    module.map((m, i) => (
      <figure
        class="relative border-rule px-3 py-5 not-last:border-r sm:px-8 sm:first:pl-0 sm:last:pr-0"
        style={`--mod:${i}`}
      >
        {/* Der Takt läuft über die Oberkante von Modul zu Modul. */}
        <span class="signet__takt" aria-hidden="true" />

        <div class="text-ink-4">
          {m.id === 'interface' && (
            <svg viewBox="0 0 200 116" class="signet__svg" role="img" aria-label="Eine Oberfläche wird aufgebaut">
              <rect x="1" y="1" width="198" height="114" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5" />
              <line x1="1" y1="23" x2="199" y2="23" stroke="currentColor" stroke-width="1" opacity="0.5" />
              <rect x="11" y="9.5" width="5" height="5" fill="currentColor" opacity="0.55" />
              <rect x="20" y="9.5" width="5" height="5" fill="currentColor" opacity="0.55" />
              <rect x="29" y="9.5" width="5" height="5" fill="currentColor" opacity="0.55" />
              <g class="signet__baut">
                <rect x="16" y="38" width="104" height="11" class="signet__block" style="--d:0" />
                <rect x="16" y="57" width="72" height="6" class="signet__block" style="--d:1" />
                <rect x="16" y="71" width="52" height="6" class="signet__block" style="--d:2" />
                <rect x="16" y="88" width="46" height="15" class="signet__block signet__block--akzent" style="--d:3" />
                <rect x="136" y="38" width="48" height="65" class="signet__block" style="--d:4" />
              </g>
            </svg>
          )}

          {m.id === 'logik' && (
            <svg viewBox="0 0 200 116" class="signet__svg" role="img" aria-label="Code wird geschrieben">
              <g class="signet__tippt">
                {[
                  [10, 0, 62], [10, 1, 96], [22, 2, 78], [22, 3, 108],
                  [34, 4, 64], [22, 5, 86], [10, 6, 44],
                ].map(([x, i, w]) => (
                  <rect x={x} y={12 + i * 14} width={w} height="5" class="signet__zeile" style={`--d:${i}`} />
                ))}
                <rect x="10" y="110" width="7" height="5" class="signet__caret" />
              </g>
            </svg>
          )}

          {m.id === 'automation' && (
            <svg viewBox="0 0 200 116" class="signet__svg" role="img" aria-label="Ein Ablauf läuft durch">
              <g stroke="currentColor" stroke-width="1" fill="none" opacity="0.45">
                <path d="M24 58 H74" />
                <path d="M74 58 L118 30" />
                <path d="M74 58 L118 86" />
                <path d="M118 30 L166 58" />
                <path d="M118 86 L166 58" />
              </g>
              {[[24, 58, 0], [74, 58, 1], [118, 30, 2], [118, 86, 2], [166, 58, 3]].map(([cx, cy, d]) => (
                <rect x={Number(cx) - 4} y={Number(cy) - 4} width="8" height="8" class="signet__knoten" style={`--d:${d}`} />
              ))}
              <rect width="6" height="6" class="signet__token" />
            </svg>
          )}
        </div>

        <figcaption class="mt-4 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
          <span class="text-[0.8125rem] font-medium tracking-[-0.02em] text-ink sm:text-[0.9375rem]">{m.label}</span>
          <span class="tech-label text-[0.5625rem] sm:text-[0.6875rem]">{m.bezug}</span>
        </figcaption>
      </figure>
    ))
  }
</div>
