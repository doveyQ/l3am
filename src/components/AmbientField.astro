---
/**
 * Der Untergrund der ganzen Seite: ein Punktraster auf Canvas, fest hinter
 * allem. Bewusst **ohne** Bewegung — es wird einmal gezeichnet und danach
 * nur bei Größenänderung neu.
 *
 * Bewegung gibt es auf dieser Seite an genau zwei Stellen, und beide sind
 * inhaltlich begründet: das Signet im Hero und der Globus. Der Hintergrund
 * ist Papier, kein Bildschirmschoner.
 */
---

<canvas data-field class="backdrop" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-field]');

  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true });
    const SPACING = 32;
    const INK = '113, 113, 122';

    function zeichnen() {
      if (!ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = window.innerWidth;
      const h = window.innerHeight;

      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      canvas!.style.width = `${w}px`;
      canvas!.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      ctx.fillStyle = `rgba(${INK}, 0.22)`;
      for (let y = 0; y <= h + SPACING; y += SPACING) {
        for (let x = 0; x <= w + SPACING; x += SPACING) {
          ctx.beginPath();
          ctx.arc(x, y, 0.95, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    zeichnen();

    let timer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(zeichnen, 160);
    });
  }
</script>
