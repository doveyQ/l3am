---
import Gauge from '@lucide/astro/icons/gauge';
import Layers from '@lucide/astro/icons/layers';
import FileCode from '@lucide/astro/icons/file-code';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Workflow from '@lucide/astro/icons/workflow';
import Database from '@lucide/astro/icons/database';
import Plug from '@lucide/astro/icons/plug';
import Bot from '@lucide/astro/icons/bot';

/** Was tatsächlich beauftragt wird, nach Häufigkeit geordnet. */
const arbeiten = [
  { typ: 'Landingpage & Marketing-Site', detail: 'Der häufigste Auftrag' },
  { typ: 'Mehrseitige Website mit Redaktion', detail: 'Headless CMS' },
  { typ: 'Webapp & Dashboard', detail: 'Wenn aus der Seite ein Werkzeug wird' },
  { typ: 'Frontend auf bestehendem Backend', detail: 'Eure Logik, unser Interface' },
];

/** Die tatsächlichen Stufen einer RAG-Pipeline, in Reihenfolge. */
const pipeline = [
  { stufe: 'Quellen', detail: 'PDF, ERP, Postfach' },
  { stufe: 'Chunking', detail: 'strukturerhaltend' },
  { stufe: 'Embedding', detail: 'Vektor-Index' },
  { stufe: 'Retrieval', detail: 'Top-k + Rerank' },
  { stufe: 'Modell', detail: 'belegte Antwort' },
  { stufe: 'Prüfung', detail: 'Eval + Schwellwert' },
  { stufe: 'Aktion', detail: 'API, Freigabe' },
];

const web = [
  { icon: Layers, titel: 'Design und Umsetzung aus einer Hand', detail: 'Kein Design, das an der Übergabe scheitert.' },
  { icon: FileCode, titel: 'Astro- und Next.js-Architekturen', detail: 'Statisch, wo es geht. Server, wo es sein muss.' },
  { icon: Gauge, titel: 'Ladezeit als Abnahmekriterium', detail: 'Vor der Abnahme gemessen, nicht danach.' },
  { icon: ShieldCheck, titel: 'Typsichere Full-Stack-Systeme', detail: 'Ein Datenvertrag gilt bis ins Formularfeld.' },
];

const ki = [
  { icon: Database, titel: 'Custom RAG-Pipelines', detail: 'Antworten mit Beleg aus euren Dokumenten.' },
  { icon: Workflow, titel: 'Autonome Workflows', detail: 'Wiederkehrende Abläufe laufen ohne Zutun durch.' },
  { icon: Bot, titel: 'LLM-Integrationen', detail: 'Modelle im Bestandssystem, nicht daneben.' },
  { icon: Plug, titel: 'API-Orchestrierung', detail: 'ERP, CRM und Postfach sprechen miteinander.' },
];
---

<section id="leistungen" class="border-b border-rule">
  <div class="shell">
    <div class="grid gap-x-16 gap-y-6 border-b border-rule py-16 md:py-24 lg:grid-cols-12">
      <h2 class="section-head reveal rise lg:col-span-7">
        <span><span>Zwei Standbeine.</span></span>
        <span><span class="text-ink-3" style="--line:1">Ein Team dahinter.</span></span>
      </h2>
      <p class="rise max-w-[42ch] self-end text-ink-3 lg:col-span-5" style="--rise-delay:180ms">
        Vorne das Interface, dahinter die Automatisierung — beides von denselben
        Leuten gebaut.
      </p>
    </div>

    <!-- Zwei gleich gebaute Blöcke: Label, Titel, Satz, vier Punkte.
         Das Detail-Artefakt liegt bei beiden hinter demselben Aufklapper,
         damit die Sektion eingeklappt in beiden Spalten gleich hoch ist. -->
    <div class="grid grid-cols-1 items-stretch lg:grid-cols-12">
      {
        [
          {
            label: 'Disziplin A · Web Design & Frontend',
            titel: 'Landingpages, die gebaut aussehen. Nicht zusammengeklickt.',
            satz: 'Der Schwerpunkt liegt auf Gestaltung und Frontend — am häufigsten Landingpages, regelmäßig Webapps, auf Wunsch bis in den Backend-Stack.',
            punkte: web,
            mehr: 'Was wir konkret bauen',
            art: 'liste' as const,
          },
          {
            label: 'Disziplin B · KI-Automatisierung',
            titel: 'Automatisierung, die belegen kann, warum sie so entschieden hat.',
            satz: 'Ein Sprachmodell allein ist noch kein Prozess. Zu einem wird es erst durch die Kette davor und danach — die bauen wir.',
            punkte: ki,
            mehr: 'Die Kette im Detail',
            art: 'kette' as const,
          },
        ].map((d, i) => (
          <article
            class:list={[
              'rise flex flex-col border-rule py-12 lg:col-span-6 lg:py-16',
              i === 0 ? 'lg:border-r lg:pr-14' : 'border-t lg:border-t-0 lg:pl-14',
            ]}
            style={`--rise-delay:${i * 140}ms`}
          >
            <span class="tech-label text-accent">{d.label}</span>
            <h3 class="mt-5 max-w-[20ch] text-[clamp(1.5rem,1.1rem+1.1vw,2.125rem)] leading-[1.08] font-medium tracking-[-0.035em]">
              {d.titel}
            </h3>
            <p class="mt-5 max-w-[44ch] leading-[1.6] text-ink-3">{d.satz}</p>

            <ul class="mt-10 border-t border-rule">
              {d.punkte.map((pkt) => (
                <li class="flex items-start gap-3.5 border-b border-rule py-4">
                  <pkt.icon size={17} stroke-width={1.5} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
                  <div>
                    <h4 class="text-[0.9375rem] font-medium tracking-[-0.01em]">{pkt.titel}</h4>
                    <p class="mt-1.5 text-[0.875rem] leading-[1.5] text-ink-4">{pkt.detail}</p>
                  </div>
                </li>
              ))}
            </ul>

            <details class="gruppe mt-auto pt-8">
              <summary class="gruppe__schalter">
                <span class="gruppe__text">{d.mehr}</span>
                <span class="gruppe__zeichen" aria-hidden="true" />
              </summary>

              <div class="gruppe__inhalt">
                {d.art === 'liste' ? (
                  <ul class="border-t border-rule">
                    {arbeiten.map((a) => (
                      <li class="group/row flex items-baseline justify-between gap-6 border-b border-rule py-3.5 transition-colors duration-300 hover:bg-accent-wash">
                        <span class="text-[0.9375rem] text-ink-2">{a.typ}</span>
                        <span class="font-mono text-[0.6875rem] tracking-[0.04em] text-ink-4 transition-colors duration-300 group-hover/row:text-accent">
                          {a.detail}
                        </span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <ol class="border-t border-rule">
                    {pipeline.map((st, n) => (
                      <li class="group flex items-baseline gap-4 border-b border-rule py-3 transition-colors duration-300 hover:bg-accent-wash">
                        <span class="font-mono text-[0.6875rem] tabular-nums text-accent">
                          {String(n + 1).padStart(2, '0')}
                        </span>
                        <span class="text-[0.9375rem] text-ink-2">{st.stufe}</span>
                        <span
                          class="mx-1 h-px min-w-3 flex-1 self-center bg-rule transition-colors duration-300 group-hover:bg-accent"
                          aria-hidden="true"
                        />
                        <span class="font-mono text-[0.75rem] text-ink-4">{st.detail}</span>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            </details>
          </article>
        ))
      }
    </div>
  </div>
</section>
